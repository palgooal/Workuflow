# بيئة الاختبارات المعزولة — تُقرأ تلقائياً عند APP_ENV=testing (أي عند
# php artisan test / vendor/bin/pest). القيم هنا مطابقة لـ phpunit.xml عمداً
# (طبقة حماية إضافية موثَّقة صراحةً، وليست بديلاً عن الحارس في
# AppServiceProvider::register() — راجع تعليقه لتفاصيل حادثة 2026-07-14
# التي مُسحت فيها بيانات قاعدة darahum المحلية الحقيقية بسبب config مخبَّأ
# تجاوز عزل الاختبارات).
#
# تحذير: لا تضع هنا أبداً DB_DATABASE يشير لقاعدة بيانات حقيقية.

APP_ENV=testing
APP_DEBUG=true

# مفتاح تشفير مخصّص للاختبارات فقط (وليس مفتاح الإنتاج) — مطلوب لأي اختبار
# يستخدم Signed URLs (URL::temporarySignedRoute) أو التشفير، مثل
# tests/Feature/Backups/BackupAdminAccessTest.php. تم توليده عشوائياً بنفس
# صيغة `php artisan key:generate --show`.
APP_KEY=base64:EQXRhvgP/H9voBl89Y9rexGbOiwSugxiUJAzQlfTtjg=

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null

BCRYPT_ROUNDS=4
